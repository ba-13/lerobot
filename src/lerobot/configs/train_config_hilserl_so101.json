{
  "dataset": {
    "repo_id": "ba-13/so101_cube_pickup",
    "root": "data_so101_cube_pickup"
  },
  "env": {
    "type": "gym_manipulator",
    "fps": 30,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/so101_follower",
      "use_degrees": true,
      "cameras": {
        "wrist": {
          "type": "opencv",
          "index_or_path": 0,
          "width": 640,
          "height": 480,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/so101_leader",
      "id": "leader",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": false,
        "add_ee_pose_to_observation": true,
        "display_cameras": true
      },
      "image_preprocessing": {
        "crop_params_dict": null,
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.01
      },
      "reset": {
        "fixed_reset_joint_positions": [
          0.0,
          -40.0,
          0.0,
          100.0,
          -90.0,
          0.0
        ],
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "reward_classifier": {
        "pretrained_path": "outputs/reward_classifier/",
        "success_threshold": 0.7,
        "success_reward": 1.0
      },
      "max_gripper_pos": 100.0
    },
    "features": {
      "wrist": {
        "type": "VISUAL",
        "shape": [480, 640, 3]
      },
      "action": {
        "type": "ACTION",
        "shape": [6]
      }
    },
    "features_map": {
      "wrist": "observation.images.wrist",
      "action": "action"
    }
  },
  "policy": {
    "repo_id": "ba-13/policy_so101_cube_pickup",
    "push_to_hub": false,
    "type": "sac",
    "device": "cuda",
    "storage_device": "cpu",
    "vision_encoder_name": "helper2424/resnet10",
    "freeze_vision_encoder": true,
    "image_encoder_hidden_dim": 32,
    "shared_encoder": true,
    "num_discrete_actions": 1,
    "image_embedding_pooling_dim": 8,
    "online_steps": 20000,
    "online_buffer_capacity": 10000,
    "offline_buffer_capacity": 10000,
    "async_prefetch": false,
    "online_step_before_learning": 1000,
    "policy_update_freq": 1,
    "discount": 0.99,
    "num_critics": 2,
    "num_subsample_critics": null,
    "critic_lr": 3e-4,
    "actor_lr": 3e-4,
    "temperature_init": 1e-2,
    "temperature_lr": 3e-4,
    "critic_target_update_weight": 0.005,
    "utd_ratio": 1,
    "state_encoder_hidden_dim": 256,
    "latent_dim": 256,
    "target_entropy": null,
    "use_backup_entropy": true,
    "grad_clip_norm": 40.0,
    "n_obs_steps": 1,
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          6
        ]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          128,
          128,
          3
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          6
        ]
      }
    },
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX",
      "ACTION": "MIN_MAX"
    },
    "dataset_stats": {
      "observation.state": {
        "min": [
          -180.0,
          -180.0,
          -180.0,
          -180.0,
          -180.0,
          0.0
        ],
        "max": [
          180.0,
          180.0,
          180.0,
          180.0,
          180.0,
          100.0
        ]
      },
      "observation.images.wrist": {
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ]
      },
      "action": {
        "min": [
          -180.0,
          -180.0,
          -180.0,
          -180.0,
          -180.0,
          0.0
        ],
        "max": [
          180.0,
          180.0,
          180.0,
          180.0,
          180.0,
          100.0
        ]
      }
    },
    "critic_network_kwargs": {
      "hidden_dims": [
        256,
        256
      ],
      "activate_final": true,
      "final_activation": null
    },
    "actor_network_kwargs": {
      "hidden_dims": [
        256,
        256
      ],
      "activate_final": true
    },
    "policy_kwargs": {
      "use_tanh_squash": true,
      "std_min": 1e-5,
      "std_max": 10.0,
      "init_final": 0.05
    },
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 4,
      "queue_get_timeout": 2.0
    },
    "concurrency": {
      "actor": "threads",
      "learner": "threads"
    },
    "use_torch_compile": false
  },
  "output_dir": "outputs/train/hilserl_so101_pick_place",
  "job_name": "hilserl_so101_pick_place",
  "resume": false,
  "seed": 1000,
  "batch_size": 256,
  "steps": 20000,
  "eval_freq": 10000,
  "log_freq": 200,
  "save_checkpoint": true,
  "save_freq": 20000,
  "wandb": {
    "enable": true,
    "project": "cube_pick",
    "disable_artifact": false,
    "entity": null,
    "notes": null,
    "run_id": null,
    "mode": null
  }
}